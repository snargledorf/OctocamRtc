<form class="form-horizontal" onsubmit="return false;">
    <h3>{{ _('OctoCam — WebRTC & STUN/TURN Configuration') }}</h3>

    <!-- Section 1: go2rtc Server & Stream Selection -->
    <fieldset>
        <legend>{{ _('go2rtc Media Server Configuration') }}</legend>

        <div class="control-group">
            <label class="control-label" for="octocam_webcam_name">{{ _('Webcam Display Name') }}</label>
            <div class="controls">
                <input id="octocam_webcam_name" type="text" class="input-xlarge"
                       data-bind="value: settingsViewModel.settings.plugins.octocam.webcam_name">
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocam_go2rtc_url">{{ _('go2rtc Server URL') }}</label>
            <div class="controls">
                <div class="input-append">
                    <input id="octocam_go2rtc_url" type="text" class="input-xlarge"
                           placeholder="http://127.0.0.1:1984"
                           data-bind="value: settingsViewModel.settings.plugins.octocam.go2rtc_url">
                    <button class="btn" type="button" data-bind="click: testGo2rtcConnection, disable: isTestingGo2rtc()">
                        <i class="fa fa-plug"></i> {{ _('Test Connection') }}
                    </button>
                </div>
                <span class="help-block">
                    {{ _('Base URL of the go2rtc server (default: http://127.0.0.1:1984).') }}
                </span>
                <div class="octocam-status-banner" data-bind="visible: go2rtcTestMessage(), css: { 'text-success': go2rtcTestOk(), 'text-error': !go2rtcTestOk() }">
                    <small data-bind="text: go2rtcTestMessage"></small>
                </div>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocam_go2rtc_stream">{{ _('Camera Stream') }}</label>
            <div class="controls">
                <!-- Dropdown when streams are discovered from go2rtc -->
                <div data-bind="visible: availableStreams().length > 0">
                    <div class="input-append">
                        <select id="octocam_go2rtc_stream_select" class="input-large"
                                data-bind="options: availableStreams, value: settingsViewModel.settings.plugins.octocam.go2rtc_stream">
                        </select>
                        <button class="btn" type="button" data-bind="click: loadAvailableStreams, disable: isLoadingStreams()" title="{{ _('Refresh streams from go2rtc') }}">
                            <i class="fa fa-refresh" data-bind="css: { 'fa-spin': isLoadingStreams }"></i>
                        </button>
                    </div>
                    <span class="help-block">
                        {{ _('Select which go2rtc stream is used as the camera for OctoPrint.') }}
                    </span>
                </div>

                <!-- Text fallback input when no streams are loaded yet -->
                <div data-bind="visible: availableStreams().length === 0">
                    <div class="input-append">
                        <input id="octocam_go2rtc_stream_text" type="text" class="input-large"
                               placeholder="octocam"
                               data-bind="value: settingsViewModel.settings.plugins.octocam.go2rtc_stream">
                        <button class="btn" type="button" data-bind="click: loadAvailableStreams, disable: isLoadingStreams()" title="{{ _('Query go2rtc streams') }}">
                            <i class="fa fa-refresh" data-bind="css: { 'fa-spin': isLoadingStreams }"></i> {{ _('Discover Streams') }}
                        </button>
                    </div>
                    <span class="help-block">
                        {{ _('Stream name configured in go2rtc.yaml (e.g. "octocam" or "cam").') }}
                    </span>
                </div>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocam_snapshot_url">{{ _('Optional Snapshot URL') }}</label>
            <div class="controls">
                <input id="octocam_snapshot_url" type="text" class="input-xlarge"
                       placeholder="Leave blank to capture automatically"
                       data-bind="value: settingsViewModel.settings.plugins.octocam.snapshot_url">
                <span class="help-block">
                    {{ _('Leave blank to automatically pull JPEG snapshots directly from go2rtc (/api/frame.jpeg).') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label">{{ _('Orientation & Aspect Ratio') }}</label>
            <div class="controls">
                <label class="checkbox inline">
                    <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octocam.flip_h"> {{ _('Flip Horizontally') }}
                </label>
                <label class="checkbox inline">
                    <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octocam.flip_v"> {{ _('Flip Vertically') }}
                </label>
                <label class="checkbox inline">
                    <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octocam.rotate90"> {{ _('Rotate 90° CCW') }}
                </label>
                <select class="input-small" style="margin-left: 12px;"
                        data-bind="value: settingsViewModel.settings.plugins.octocam.aspect_ratio">
                    <option value="16:9">16:9</option>
                    <option value="4:3">4:3</option>
                </select>
            </div>
        </div>
    </fieldset>

    <!-- Section 2: Cloudflare Calls TURN Server -->
    <fieldset>
        <legend>{{ _('Cloudflare Calls TURN Integration') }}</legend>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octocam.cloudflare_enabled">
                    <strong>{{ _('Enable Dynamic Cloudflare TURN Credentials') }}</strong>
                </label>
                <span class="help-block">
                    {{ _('Automatically generates short-lived TURN credentials via the Cloudflare Calls TURN API for both the OctoPrint host and remote browser viewers.') }}
                </span>
            </div>
        </div>

        <div data-bind="visible: settingsViewModel.settings.plugins.octocam.cloudflare_enabled">
            <div class="control-group">
                <label class="control-label" for="octocam_cf_key_id">{{ _('Cloudflare TURN Key ID') }}</label>
                <div class="controls">
                    <input id="octocam_cf_key_id" type="text" class="input-xlarge"
                           placeholder="e.g. 5dc9a1..."
                           data-bind="value: settingsViewModel.settings.plugins.octocam.cloudflare_turn_key_id">
                    <span class="help-block">
                        {{ _('The Cloudflare Calls App TURN Key ID created in your Cloudflare dashboard.') }}
                    </span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label" for="octocam_cf_api_token">{{ _('Cloudflare API Token') }}</label>
                <div class="controls">
                    <input id="octocam_cf_api_token" type="password" class="input-xlarge"
                           placeholder="e.g. secret_token_xyz"
                           data-bind="value: settingsViewModel.settings.plugins.octocam.cloudflare_api_token">
                    <span class="help-block">
                        {{ _('API token / secret with permission to generate TURN credentials.') }}
                    </span>
                </div>
            </div>

            <div class="control-group">
                <label class="control-label" for="octocam_cf_ttl">{{ _('Credential TTL (Seconds)') }}</label>
                <div class="controls">
                    <input id="octocam_cf_ttl" type="number" min="60" max="86400" class="input-small"
                           data-bind="value: settingsViewModel.settings.plugins.octocam.cloudflare_ttl">
                    <span class="help-inline">{{ _('Default: 3600 (1 hour). Credentials are automatically cached and renewed.') }}</span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <label class="checkbox">
                        <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octocam.force_turn_relay">
                        {{ _('Force TURN Relay (iceTransportPolicy: relay)') }}
                    </label>
                    <span class="help-block">
                        {{ _('Forces all WebRTC traffic through the TURN relay. Helpful for strict symmetric NAT or troubleshooting WAN access.') }}
                    </span>
                </div>
            </div>

            <div class="control-group">
                <div class="controls">
                    <button class="btn" type="button" data-bind="click: testCloudflareTurn, disable: isTestingCloudflare()">
                        <i class="fa fa-cloud"></i> {{ _('Test Cloudflare TURN Credentials') }}
                    </button>
                    <div class="octocam-status-banner" data-bind="visible: cloudflareTestMessage(), css: { 'text-success': cloudflareTestOk(), 'text-error': !cloudflareTestOk() }">
                        <small data-bind="text: cloudflareTestMessage"></small>
                    </div>
                </div>
            </div>
        </div>
    </fieldset>

    <!-- Section 3: Static ICE Servers Fallback -->
    <fieldset>
        <legend>{{ _('Static STUN / TURN Servers (Fallback)') }}</legend>
        <span class="help-block">
            {{ _('Static servers used when Cloudflare Calls TURN is disabled or as a fallback if the Cloudflare API is temporarily unreachable.') }}
        </span>

        <table class="table table-striped table-bordered table-condensed" style="max-width: 600px;">
            <thead>
                <tr>
                    <th>{{ _('Server URL (stun:... or turn:...)') }}</th>
                    <th>{{ _('Username') }}</th>
                    <th>{{ _('Credential') }}</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody data-bind="foreach: iceServersList">
                <tr>
                    <td>
                        <input type="text" class="input-medium" data-bind="value: urls"
                               placeholder="stun:stun.cloudflare.com:3478">
                    </td>
                    <td>
                        <input type="text" class="input-small" data-bind="value: username"
                               placeholder="optional">
                    </td>
                    <td>
                        <input type="password" class="input-small" data-bind="value: credential"
                               placeholder="optional">
                    </td>
                    <td style="text-align: center;">
                        <button class="btn btn-mini btn-danger" type="button"
                                data-bind="click: $parent.removeIceServer" title="{{ _('Remove Server') }}">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>

        <button class="btn btn-small" type="button" data-bind="click: addIceServer">
            <i class="fa fa-plus"></i> {{ _('Add ICE Server') }}
        </button>
    </fieldset>
</form>
