<div id="octocam_webcam_container" class="octocam-player-wrapper">
    <div class="octocam-video-viewport" data-bind="css: viewportCss()">
        <div class="octocam-rotation-container">
            <video id="octocam_webrtc_video"
                   class="octocam-video-element"
                   autoplay
                   playsinline
                   muted></video>
        </div>

        <div class="octocam-overlay-bar">
            <span class="octocam-badge" data-bind="css: statusBadgeClass(), text: connectionBadgeText()">
                Connecting...
            </span>

            <div class="octocam-controls">
                <button class="btn btn-mini btn-inverse" type="button"
                        data-bind="click: reconnectStream"
                        title="{{ _('Reconnect WebRTC Stream') }}">
                    <i class="fa fa-refresh"></i>
                </button>
                <button class="btn btn-mini btn-inverse" type="button"
                        data-bind="click: toggleFullscreen"
                        title="{{ _('Fullscreen') }}">
                    <i class="fa fa-arrows-alt"></i>
                </button>
            </div>
        </div>
    </div>
</div>
