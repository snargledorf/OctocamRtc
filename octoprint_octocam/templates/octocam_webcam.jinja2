<div id="octocam_webcam_container" class="octocam-player-wrapper">
    <div class="octocam-video-viewport" data-bind="css: viewportCss()">
        <div class="octocam-rotation-container">
            <!-- Poster Snapshot Display (visible while connecting / loading feed) -->
            <img id="octocam_poster_image"
                 class="octocam-poster-element"
                 data-bind="attr: { src: posterUrl }, css: { 'poster-hidden': !showPoster() }"
                 alt="{{ _('Webcam snapshot preview') }}" />

            <!-- Loading Spinner & Status Overlay (centered) -->
            <div class="octocam-poster-overlay" data-bind="css: { 'poster-hidden': !showPoster() }">
                <div class="octocam-poster-badge">
                    <!-- ko if: connectionState() === 'connecting' -->
                    <i class="fa fa-circle-o-notch fa-spin octocam-spinner"></i>
                    <!-- /ko -->
                    <!-- ko if: connectionState() === 'error' -->
                    <i class="fa fa-exclamation-triangle" style="color: #f87171;"></i>
                    <!-- /ko -->
                    <!-- ko if: connectionState() === 'idle' -->
                    <i class="fa fa-clock-o" style="color: #94a3b8;"></i>
                    <!-- /ko -->
                    <span data-bind="text: posterNoticeText"></span>
                </div>
            </div>

            <video id="octocam_webrtc_video"
                   class="octocam-video-element"
                   autoplay
                   playsinline
                   muted></video>
        </div>

        <div class="octocam-overlay-bar">
            <span class="octocam-badge" data-bind="css: statusBadgeClass(), text: connectionBadgeText()">
                Connecting...
            </span>

            <div class="octocam-controls">
                <select class="input-medium" style="margin: 0 4px; height: 22px; font-size: 11px; padding: 1px 4px; background: rgba(0,0,0,0.6); color: #fff; border: 1px solid rgba(255,255,255,0.2);"
                        data-bind="visible: availableStreams().length > 1, options: availableStreams, value: selectedStream"
                        title="{{ _('Switch go2rtc Camera Stream') }}">
                </select>
                <button class="btn btn-mini btn-inverse" type="button"
                        data-bind="click: reconnectStream"
                        title="{{ _('Reconnect WebRTC Stream') }}">
                    <i class="fa fa-refresh"></i>
                </button>
                <button class="btn btn-mini btn-inverse" type="button"
                        data-bind="click: toggleFullscreen"
                        title="{{ _('Fullscreen') }}">
                    <i class="fa fa-arrows-alt"></i>
                </button>
            </div>
        </div>
    </div>
</div>
