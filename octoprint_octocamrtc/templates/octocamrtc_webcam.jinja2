<div id="octocamrtc_webcam_container" class="octocamrtc-player-wrapper octocam-player-wrapper">
    <div class="octocamrtc-video-viewport octocam-video-viewport" data-bind="css: viewportCss()">
        <webrtc-stream id="octocamrtc_player_element"
                       class="octocamrtc-stream-player octocam-stream-player"
                       data-bind="attr: {
                           gateway: gatewayUrl,
                           stream: selectedStream,
                           autoplay: autoplayAttr,
                           muted: mutedAttr,
                           controls: controlsAttr,
                           poster: posterAttr
                       }">
        </webrtc-stream>

        <!-- Quick Stream Switcher Dropdown (visible if multiple streams exist) -->
        <!-- ko if: availableStreams().length > 1 -->
        <div class="octocamrtc-stream-selector-bar octocam-stream-selector-bar">
            <span class="octocamrtc-badge octocam-badge" style="margin-right: 4px;">
                <i class="fa fa-video-camera"></i>
            </span>
            <select class="input-medium octocamrtc-stream-select"
                    data-bind="options: availableStreams, value: selectedStream"
                    title="{{ _('Switch Camera Stream') }}">
            </select>
        </div>
        <!-- /ko -->
    </div>
</div>
