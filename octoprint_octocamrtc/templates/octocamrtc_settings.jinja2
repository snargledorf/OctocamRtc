<form class="form-horizontal" onsubmit="return false;">
    <h3>{{ _('OctoCamRTC — WebRTC & STUN/TURN Configuration') }}</h3>

    <!-- Section 1: Webcam & Stream Configuration -->
    <fieldset>
        <legend>{{ _('Webcam & Stream Configuration') }}</legend>

        <div class="control-group">
            <label class="control-label" for="octocamrtc_webcam_name">{{ _('Webcam Display Name') }}</label>
            <div class="controls">
                <input id="octocamrtc_webcam_name" type="text" class="input-xlarge"
                       data-bind="value: settingsViewModel.settings.plugins.octocamrtc.webcam_name">
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocamrtc_go2rtc_stream">{{ _('Camera Stream') }}</label>
            <div class="controls">
                <!-- Dropdown when streams are discovered from go2rtc -->
                <div data-bind="visible: availableStreams().length > 0">
                    <div class="input-append">
                        <select id="octocamrtc_go2rtc_stream_select" class="input-large"
                                data-bind="options: availableStreams, value: settingsViewModel.settings.plugins.octocamrtc.go2rtc_stream">
                        </select>
                        <button class="btn" type="button" data-bind="click: loadAvailableStreams, disable: isLoadingStreams()" title="{{ _('Refresh streams from go2rtc') }}">
                            <i class="fa fa-refresh" data-bind="css: { 'fa-spin': isLoadingStreams }"></i>
                        </button>
                    </div>
                    <span class="help-block">
                        {{ _('Select which go2rtc stream is used as the camera for OctoPrint.') }}
                    </span>
                </div>

                <!-- Text fallback input when no streams are loaded yet -->
                <div data-bind="visible: availableStreams().length === 0">
                    <div class="input-append">
                        <input id="octocamrtc_go2rtc_stream_text" type="text" class="input-large"
                               placeholder="octocamrtc"
                               data-bind="value: settingsViewModel.settings.plugins.octocamrtc.go2rtc_stream">
                        <button class="btn" type="button" data-bind="click: loadAvailableStreams, disable: isLoadingStreams()" title="{{ _('Query go2rtc streams') }}">
                            <i class="fa fa-refresh" data-bind="css: { 'fa-spin': isLoadingStreams }"></i> {{ _('Discover Streams') }}
                        </button>
                    </div>
                    <span class="help-block">
                        {{ _('Stream name configured in go2rtc.yaml (e.g. "octocamrtc" or "cam").') }}
                    </span>
                </div>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocamrtc_stream_url">{{ _('Optional Stream URL') }}</label>
            <div class="controls">
                <input id="octocamrtc_stream_url" type="text" class="input-xlarge"
                       placeholder="Leave blank to stream automatically"
                       data-bind="value: settingsViewModel.settings.plugins.octocamrtc.stream_url">
                <span class="help-block">
                    {{ _('Leave blank to automatically stream MJPEG directly from go2rtc (/api/stream.mjpeg?src=...). Set a custom URL if Home Assistant or external clients require a specific hostname/IP or separate stream.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocamrtc_snapshot_url">{{ _('Optional Snapshot URL') }}</label>
            <div class="controls">
                <input id="octocamrtc_snapshot_url" type="text" class="input-xlarge"
                       placeholder="Leave blank to capture automatically"
                       data-bind="value: settingsViewModel.settings.plugins.octocamrtc.snapshot_url">
                <span class="help-block">
                    {{ _('Leave blank to automatically pull JPEG snapshots directly from go2rtc (/api/frame.jpeg).') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.sync_octoprint_stream">
                    {{ _('Sync OctoPrint Stream & Snapshot URLs') }}
                </label>
                <span class="help-block">
                    {{ _('Automatically keep OctoPrint\'s global webcam stream and snapshot URLs synchronized with this MJPEG stream so that Home Assistant and other external clients can stream the camera.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.snapshot_caching_enabled">
                    <strong>{{ _('Enable Snapshot Background Caching (Instant Poster)') }}</strong>
                </label>
                <span class="help-block">
                    {{ _('Periodically pre-fetches and caches snapshots in memory so that opening the webcam view immediately displays a recent preview while the WebRTC connection establishes.') }}
                </span>
            </div>
        </div>

        <div class="control-group" data-bind="visible: settingsViewModel.settings.plugins.octocamrtc.snapshot_caching_enabled">
            <label class="control-label" for="octocamrtc_snapshot_cache_interval">{{ _('Cache Refresh Interval') }}</label>
            <div class="controls">
                <div class="input-append">
                    <input id="octocamrtc_snapshot_cache_interval" type="number" class="input-mini" min="1" max="60"
                           data-bind="value: settingsViewModel.settings.plugins.octocamrtc.snapshot_cache_interval">
                    <span class="add-on">{{ _('sec') }}</span>
                </div>
                <span class="help-block">
                    {{ _('Frequency to cycle snapshot pre-fetching (default: 5 seconds).') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <label class="control-label" for="octocamrtc_aspect_ratio">{{ _('Aspect Ratio') }}</label>
            <div class="controls">
                <select id="octocamrtc_aspect_ratio" class="input-medium"
                        data-bind="value: settingsViewModel.settings.plugins.octocamrtc.aspect_ratio">
                    <option value="16:9">16:9</option>
                    <option value="4:3">4:3</option>
                </select>
            </div>
        </div>
    </fieldset>

    <!-- Section 2: <webrtc-stream> Web Component Options -->
    <fieldset>
        <legend>{{ _('WebRTC Player Options (<webrtc-stream> Web Component)') }}</legend>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.player_autoplay">
                    {{ _('Autoplay Stream') }}
                </label>
                <span class="help-block">
                    {{ _('Automatically starts playback when the webcam tab or player opens.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.player_muted">
                    {{ _('Mute Audio') }}
                </label>
                <span class="help-block">
                    {{ _('Mutes audio on stream initialization (required by modern browsers for unprompted autoplay).') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.player_controls">
                    {{ _('Display Player Controls Bar') }}
                </label>
                <span class="help-block">
                    {{ _('Shows the player controls bar (play/pause, mute, snapshot, fullscreen) in the player component.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.player_poster">
                    {{ _('Show Snapshot Poster Fallback') }}
                </label>
                <span class="help-block">
                    {{ _('Displays the live cached snapshot from /api/snapshot while connecting or reconnecting.') }}
                </span>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox"
                           data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.player_reconnect">
                    {{ _('Automatic Reconnection') }}
                </label>
                <span class="help-block">
                    {{ _('Automatically attempts exponential backoff reconnection on disconnection.') }}
                </span>
            </div>
        </div>
    </fieldset>

    <!-- Section 3: WebRTC Stream Gateway Configuration -->
    <fieldset>
        <legend>{{ _('WebRTC Stream Gateway Configuration') }}</legend>

        <div class="control-group">
            <label class="control-label" for="octocamrtc_gateway_url">{{ _('Gateway Service URL') }}</label>
            <div class="controls">
                <div class="input-append">
                    <input id="octocamrtc_gateway_url" type="text" class="input-xlarge"
                           placeholder="http://127.0.0.1:8080"
                           data-bind="value: settingsViewModel.settings.plugins.octocamrtc.gateway_url">
                    <button class="btn" type="button" data-bind="click: testGatewayConnection, disable: isTestingGateway()">
                        <i class="fa fa-plug"></i> {{ _('Test Gateway Connection') }}
                    </button>
                </div>
                <span class="help-block">
                    {{ _('Base URL of the WebRtcStreamGateway service (default: http://127.0.0.1:8080).') }}
                </span>
                <div class="octocamrtc-status-banner octocam-status-banner" data-bind="visible: gatewayTestMessage(), css: { 'text-success': gatewayTestOk(), 'text-error': !gatewayTestOk() }">
                    <small data-bind="text: gatewayTestMessage"></small>
                </div>
            </div>
        </div>

        <div class="control-group">
            <div class="controls">
                <label class="checkbox">
                    <input type="checkbox" data-bind="checked: settingsViewModel.settings.plugins.octocamrtc.force_turn_relay">
                    {{ _('Force TURN Relay (iceTransportPolicy: relay)') }}
                </label>
                <span class="help-block">
                    {{ _('Forces all WebRTC traffic through the TURN relay. Helpful for strict symmetric NAT or troubleshooting WAN access.') }}
                </span>
            </div>
        </div>
    </fieldset>

    <!-- Section 4: Static ICE Servers Fallback -->
    <fieldset>
        <legend>{{ _('Static STUN / TURN Servers (Fallback)') }}</legend>
        <span class="help-block">
            {{ _('Static servers used when Cloudflare Calls TURN is disabled or as a fallback if the Cloudflare API is temporarily unreachable.') }}
        </span>

        <table class="table table-striped table-bordered table-condensed" style="max-width: 600px;">
            <thead>
                <tr>
                    <th>{{ _('Server URL (stun:... or turn:...)') }}</th>
                    <th>{{ _('Username') }}</th>
                    <th>{{ _('Credential') }}</th>
                    <th style="width: 40px;"></th>
                </tr>
            </thead>
            <tbody data-bind="foreach: iceServersList">
                <tr>
                    <td>
                        <input type="text" class="input-medium" data-bind="value: urls"
                               placeholder="stun:stun.cloudflare.com:3478">
                    </td>
                    <td>
                        <input type="text" class="input-small" data-bind="value: username"
                               placeholder="optional">
                    </td>
                    <td>
                        <input type="password" class="input-small" data-bind="value: credential"
                               placeholder="optional">
                    </td>
                    <td style="text-align: center;">
                        <button class="btn btn-mini btn-danger" type="button"
                                data-bind="click: $parent.removeIceServer" title="{{ _('Remove Server') }}">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>

        <button class="btn btn-small" type="button" data-bind="click: addIceServer">
            <i class="fa fa-plus"></i> {{ _('Add ICE Server') }}
        </button>
    </fieldset>
</form>
